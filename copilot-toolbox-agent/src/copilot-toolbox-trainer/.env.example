# The agent runs on the GitHub Copilot CLI using BYOK (Bring Your Own Key), routing
# inference to your Microsoft Foundry / Azure OpenAI endpoint. Auth is Microsoft Entra ID
# (OAuth) via DefaultAzureCredential -- no API key and no per-user GitHub Copilot subscription.
#
# In Foundry the container's managed identity is used automatically. Locally, DefaultAzureCredential
# falls back to your `az login` credential. That identity needs a Foundry model access role
# (e.g. "Azure AI User" / "Cognitive Services OpenAI User") AND access to call the toolbox
# (e.g. "Azure AI User") on the project below.

# Foundry / Azure OpenAI model inference endpoint (OpenAI v1 surface).
# NOTE: FOUNDRY_* and AGENT_* env var names are reserved by the Foundry hosted-agent
# platform, so this agent uses BYOK_* / TOOLBOX_* names for its own configuration.
BYOK_MODEL_ENDPOINT="https://<your-resource>.openai.azure.com/openai/v1/"

# Model deployment name to route requests to.
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-5.5"

# Optional BYOK / auth tuning:
#   BYOK_PROVIDER_TYPE: "openai" (default, for /openai/v1/ endpoints) or "azure".
#   BYOK_WIRE_API: "responses" (default, newer models) or "completions" (older models).
#   BYOK_TOKEN_SCOPE: Entra scope for the bearer token (default "https://ai.azure.com/.default").
#     For *.openai.azure.com endpoints use "https://cognitiveservices.azure.com/.default".
# BYOK_PROVIDER_TYPE="openai"
# BYOK_WIRE_API="responses"
BYOK_TOKEN_SCOPE="https://cognitiveservices.azure.com/.default"

# --- Foundry Toolbox (Code Interpreter) ---
# The MCP endpoint of a Foundry Toolbox that exposes a `code_interpreter` tool. Either set
# the full endpoint directly...
TOOLBOX_ENDPOINT="https://<your-resource>.services.ai.azure.com/api/projects/<project>/toolboxes/code-exec/mcp?api-version=v1"
# ...or let the agent build it from a project endpoint + toolbox name:
# AZURE_AI_PROJECT_ENDPOINT="https://<your-resource>.services.ai.azure.com/api/projects/<project>"
# TOOLBOX_NAME="code-exec"
#
# Entra scope for the toolbox bearer token. For *.services.ai.azure.com use the default below.
# TOOLBOX_TOKEN_SCOPE="https://ai.azure.com/.default"

# Which harness permission "kinds" to approve (comma-separated); any kind not listed is
# denied. The Copilot CLI gates each capability through this policy.
#   Kinds: shell (run code locally), read (read files), write (write files),
#          url (fetch web), mcp (use MCP servers -- i.e. the toolbox).
# Default "mcp,read" lets the agent call the toolbox and read files handed to it, while
# withholding LOCAL code execution so all code runs in the toolbox sandbox.
# COPILOT_ALLOWED_PERMISSIONS="mcp,read"
